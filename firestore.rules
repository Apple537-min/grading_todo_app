rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // -----------------------------------------------------------------
    // HELPER FUNCTIONS
    // -----------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the user has a specific role (e.g. via a record in /admins)
    function isTeacher() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email.endsWith('@mendoza.edu') // Example email domain rule
      );
    }

    function getStudentCustomId() {
      return get(/databases/$(database)/documents/students/$(request.auth.uid)).data.student_id;
    }

    function isOwner(resourceData) {
      return isAuthenticated() && (
        resourceData.student_id == getStudentCustomId() || 
        resourceData.student_id == request.auth.uid
      );
    }

    // -----------------------------------------------------------------
    // COLLECTIONS
    // -----------------------------------------------------------------

    match /students/{docId} {
      allow read: if isAuthenticated() && (docId == request.auth.uid || isTeacher());
      allow write: if isTeacher();
    }

    // Optimized Polymorphic Assessments Collection
    match /assessments/{assessmentId} {
      // 1. Role-Based Access: Students read own data, Teacher full access
      allow read: if isOwner(resource.data) || isTeacher();
      
      // 2. Teacher-only CUD
      allow create, update, delete: if isTeacher();

      // 3. Data Validation
      allow write: if request.resource.data.score <= request.resource.data.total_items
                   && request.resource.data.student_id is string
                   && request.resource.data.type in ['quiz', 'exam', 'activity', 'oral', 'project'];

      // 4. Constraint: Oral cap (50 points)
      allow write: if request.resource.data.type == 'oral' ? request.resource.data.score <= 50 : true;

      // 5. Constraint: One Exam per term (Implemented via document ID: studentId_term)
      // Note: This is best enforced in the app logic or via a more complex rule if using auto IDs.
    }

    match /attendance/{docId} {
      allow read: if isOwner(resource.data) || isTeacher();
      allow write: if isTeacher();
    }

    match /todos/{todoId} {
      allow read: if isOwner(resource.data) || isTeacher();
      allow create: if isAuthenticated() && (
        request.resource.data.student_id == getStudentCustomId() ||
        request.resource.data.student_id == request.auth.uid
      );
      allow update, delete: if isOwner(resource.data);
      
      allow write: if request.resource.data.title.size() > 0 
                   && request.resource.data.priority in ['low', 'medium', 'high']
                   && request.resource.data.status in ['pending', 'completed'];
    }
  }
}
